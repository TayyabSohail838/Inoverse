# --- Gemma (required) ---
# Google AI Studio → Get API key
GEMINI_API_KEY=paste-your-key-here
# Model used by the app
GEMMA_MODEL=gemma-4-31b-it
# Backups, tried in order when the main model is busy or out of quota (comma-separated, or "off")
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it,gemini-3.5-flash-lite
# Quicker model for live voice conversation (the gap check still uses GEMMA_MODEL)
GEMMA_FAST_MODEL=gemma-4-26b-a4b-it
# Backups for live conversation, tried in order (own free quotas, so many visitors at once still get answers; "off" to disable)
GEMMA_FAST_FALLBACK=gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Voice input (Talk button) only: speech to text. Gemma 4 31B can't take audio.
TRANSCRIBE_MODEL=gemini-3.5-flash
# (if its free daily limit runs out, voice input switches to gemini-2.5-flash, then gemini-2.5-flash-lite)
# The cofounder's spoken voice (text to speech). The free tier allows ~10 clips a day per model,
# so the app goes down this list when one runs out. Leave unset for the default list.
# TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
TTS_VOICE=Charon
# Live voice (the Live toggle, on by default): real-time listening and talking with Gemini Live.
# Gemma still runs every skill behind it. Same GEMINI_API_KEY; the browser only gets a short-lived token.
LIVE_MODEL=gemini-3.8-live

# --- AI allowance (needs supabase/usage.sql). Units: chat 1, voice 1, live 2, weekly review 3, gap check 5. "off" = no limit ---
# AI_LIMIT_USER_HOUR=60
# AI_LIMIT_ORG_DAY=400
# AI_LIMIT_IP_HOUR=30

# --- Supabase (optional, but needed to save anything and for accounts) ---
# Supabase → Project Settings → API. Run supabase/multitenant.sql first (see README).
SUPABASE_URL=https://your-project-id.supabase.co
# Server only, never in the browser
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here
# The public anon / publishable key: people sign in with it; Row Level Security limits it to their company
SUPABASE_ANON_KEY=paste-the-anon-key-here
# Any long random string; signs the Google connect step (falls back to one derived from the service key)
# APP_SECRET=

# --- Optional ---
# Without a database only: a code the app asks for once before sharing a link.
# (With Supabase, everyone signs in instead.)
# ACCESS_CODE=choose-a-code
# Slug of the company your old single-company data moved into, also used by the public demo (default inovix)
# COMPANY_SLUG=inovix

# --- Gmail tasks (optional) ---
# Google Cloud → OAuth client (Web application). See "Connect Gmail" in the README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Your timezone, for task dates and "today" (default Asia/Karachi)
# TIMEZONE=Asia/Karachi

# Country code added to local numbers that start with 0 (People panel, WhatsApp). Default 92 (Pakistan).
# DEFAULT_COUNTRY_CODE=92

# --- WhatsApp bot (optional). See "Connect WhatsApp" in the README. ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Numbers are linked per company in the app (Company → Access → WhatsApp).
# Inovo's own number, shown in the app when linking:
# WHATSAPP_DISPLAY_NUMBER=+1 555 0100
# Legacy: these numbers talk to the COMPANY_SLUG company without linking
# WHATSAPP_OWNER_NUMBER=923001234567
# Approved template (body: {{1}}) so the morning brief arrives even after 24 h of silence
# WHATSAPP_BRIEF_TEMPLATE=
# WHATSAPP_BRIEF_TEMPLATE_LANG=en
# Protects the daily brief that Vercel Cron triggers (vercel.json)
# CRON_SECRET=

# Public demo: sample Inovix tasks, meetings, people and emails, no sign-in, nothing saved.
# On automatically on Vercel, off on your laptop. Set DEMO_MODE=off on Vercel to let real companies sign up.
# DEMO_MODE=on
